                                    @endif

                                </td>


                                {{-- CURRENT STATUS --}}

                                <td>

                                    @if ($student->status === 'active')

                                        <span class="status-badge"
                                            style="
                                                background: #dcfce7;
                                                color: #166534;
                                            ">

                                            Active

                                        </span>

                                    @else

