<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Pupil Registration | FNPS Gusau</title>

    <style>
        :root {
            --primary: #1764d8;
            --primary-dark: #104da9;
            --primary-light: #eaf2ff;
            --background: #edf3ff;
            --text: #172b4d;
            --muted: #64748b;
            --border: #dbe5f3;
            --white: #ffffff;
            --success: #15803d;
            --danger: #dc2626;
            --shadow: 0 10px 30px rgba(30, 64, 125, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 28px 16px;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(
                135deg,
                #eaf2ff 0%,
                #f5f8ff 50%,
                #dce9ff 100%
            );
            color: var(--text);
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 1250px;
            margin: 0 auto;
        }

        .page-header {
            background: var(--white);
            border: 1px solid rgba(219, 229, 243, 0.9);
            border-radius: 22px;
            padding: 24px 28px;
            margin-bottom: 25px;
            box-shadow: var(--shadow);
        }

        .school-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            padding-bottom: 22px;
            border-bottom: 1px solid var(--border);
        }

        .school-logo {
            width: 130px;
            height: 130px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .school-name {
            flex: 1;
            text-align: center;
            min-width: 180px;
        }

        .school-name h2 {
            margin: 0 0 7px;
            color: #174a96;
            font-size: 23px;
            font-weight: 800;
            letter-spacing: 0.3px;
        }

        .school-name p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        .page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            padding-top: 22px;
        }

        .page-heading h1 {
            margin: 0 0 8px;
            color: #163e78;
            font-size: 27px;
            font-weight: 800;
        }

        .page-heading p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
            font-size: 14px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 18px;
            color: var(--muted);
            font-size: 13px;
        }

        .breadcrumb a {
            color: var(--primary);
            font-weight: 700;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 11px 16px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: 0.2s ease;
            font-family: inherit;
        }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(0.97);
        }

        .btn-primary {
            color: #fff;
            background: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-outline {
            color: var(--primary);
            background: #fff;
            border-color: #c7d9f5;
        }

        .btn-secondary {
            color: #334155;
            background: #e8edf5;
            border-color: #d5deeb;
        }

        .btn-success {
            color: #fff;
            background: #15803d;
        }

        .btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        .alert {
            border-radius: 12px;
            padding: 15px 17px;
            margin-bottom: 20px;
            border: 1px solid transparent;
            line-height: 1.6;
            font-size: 14px;
        }

        .alert-success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .alert-danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .alert-info {
            color: #1e40af;
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .alert ul {
            padding-left: 22px;
            margin-top: 8px;
            margin-bottom: 0;
        }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            margin-bottom: 24px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 19px 23px;
            background: linear-gradient(135deg, #f5f9ff, #eaf2ff);
            border-bottom: 1px solid var(--border);
            color: #174a96;
            font-size: 15px;
            font-weight: 800;
        }

        .card-body {
            padding: 24px;
        }

        .section-number {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            color: #fff;
            font-size: 13px;
            flex-shrink: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            min-width: 0;
        }

        label {
            display: block;
            margin-bottom: 9px;
            color: #334b6e;
            font-size: 13px;
            font-weight: 700;
        }

        .form-control {
            display: block;
            width: 100%;
            min-height: 46px;
            padding: 11px 13px;
            border: 1px solid #cbd8e9;
            border-radius: 10px;
            background: #fff;
            color: #1e293b;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            border-color: #4d8ce5;
            box-shadow: 0 0 0 3px rgba(23, 100, 216, 0.12);
        }

        .form-control:disabled {
            background: #f1f5f9;
            color: #64748b;
        }

        .form-hint {
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .form-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .session-banner {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px 17px;
            margin-bottom: 23px;
            border-radius: 12px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
        }

        .session-banner strong {
            color: #174a96;
        }

        .session-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #dbeafe;
            font-size: 18px;
            flex-shrink: 0;
        }

        .credential-card {
            border: 1px solid #bbf7d0;
            background: linear-gradient(135deg, #f0fdf4, #ffffff);
        }

        .credential-card .card-header {
            background: linear-gradient(135deg, #ecfdf5, #dcfce7);
            border-bottom-color: #bbf7d0;
            color: #166534;
        }

        .credential-notice {
            padding: 14px 16px;
            border-radius: 10px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .credential-item {
            padding: 16px;
            border: 1px solid #dbe5f3;
            border-radius: 12px;
            background: #fff;
            margin-bottom: 14px;
        }

        .credential-item:last-child {
            margin-bottom: 0;
        }

        .credential-label {
            display: block;
            margin-bottom: 8px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .credential-value {
            color: #174a96;
            font-size: 20px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .credential-footer {
            margin-top: 18px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
        }

        .table-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 20px;
        }

        .table-toolbar h3 {
            margin: 0;
            color: #1e3a64;
            font-size: 16px;
        }

        .table-toolbar p {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 12px;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }

        th {
            padding: 14px 16px;
            text-align: left;
            white-space: nowrap;
            background: #edf4ff;
            color: #234879;
            font-size: 12px;
            font-weight: 800;
            border-bottom: 1px solid #d7e4f6;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid #e7edf6;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr:nth-child(even) {
            background: #f8fbff;
        }

        tbody tr:hover {
            background: #eef5ff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .admission-number {
            color: #174a96;
            font-weight: 800;
            white-space: nowrap;
        }

        .pupil-name {
            color: #1e293b;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            background: #eaf2ff;
            color: #174a96;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .empty-state {
            text-align: center;
            padding: 28px 16px;
            color: #64748b;
        }

        .pagination-wrap {
            margin-top: 22px;
            overflow-x: auto;
        }

        .footer-note {
            text-align: center;
            color: #718096;
            font-size: 12px;
            padding: 10px 0 4px;
        }

        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .page-header,
            .card {
                box-shadow: none;
            }

            .header-actions,
            .breadcrumb,
            .registration-card,
            .registered-card,
            .footer-note {
                display: none !important;
            }

            .credential-card {
                display: block !important;
                border: 1px solid #ccc;
            }

            .credential-card .card-header {
                background: #fff;
            }

            .credential-item {
                border: 1px solid #ccc;
            }

            .credential-notice {
                background: #fff;
            }
        }

        @media (max-width: 750px) {
            body {
                padding: 16px 10px;
            }

            .page-header {
                padding: 18px;
                border-radius: 16px;
            }

            .school-header {
                justify-content: center;
                gap: 12px;
            }

            .school-logo {
                width: 55px;
                height: 55px;
            }

            .school-name {
                order: 3;
                flex-basis: 100%;
            }

            .school-name h2 {
                font-size: 18px;
            }

            .page-heading {
                align-items: flex-start;
            }

            .page-heading h1 {
                font-size: 23px;
            }

            .header-actions {
                width: 100%;
            }

            .header-actions .btn {
                flex: 1;
            }

            .card-header {
                padding: 16px;
            }

            .card-body {
                padding: 17px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-actions .btn {
                width: 100%;
            }

            .table-toolbar {
                align-items: flex-start;
            }
        }
    </style>
</head>

