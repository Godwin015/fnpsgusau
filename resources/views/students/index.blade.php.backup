                                            style="
                                                background: #fee2e2;
                                                color: #991b1b;
                                            ">

                                            Inactive

                                        </span>

                                    @endif

                                </td>


                                {{-- CHANGE STATUS --}}

                                <td>

                                    <form method="POST"
                                        action="{{ route('students.status.update', $student) }}"
                                        style="
                                            display: flex;
                                            align-items: center;
                                            gap: 8px;
                                            min-width: 180px;
                                        ">

                                        @csrf

                                        @method('PATCH')

                                        <input
                                            type="hidden"
                                            name="search"
                                            value="{{ $search }}"
                                        >

                                        <select
                                            name="status"
                                            class="form-control"
                                            aria-label="Change pupil status"
                                            style="
                                                min-width: 110px;
                                                min-height: 38px;
                                                padding: 8px;
                                                font-size: 12px;
                                            "
                                        >

                                            <option
                                                value="active"
                                                @selected($student->status === 'active')
                                            >

                                                Active

                                            </option>

                                            <option
                                                value="inactive"
                                                @selected($student->status === 'inactive')
                                            >

                                                Inactive

                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary"
                                                style="
                                                    padding: 9px 12px;
                                                    font-size: 12px;
                                                    white-space: nowrap;
                                                "
                                                onclick="return confirm('Are you sure you want to change this pupil status?')">

                                            Update

                                        </button>

                                    </form>

                                </td>


                            </tr>


                        @empty


                            <tr>

                                <td colspan="5">

                                    <div class="empty-state">

                                        <strong>

                                            @if ($search !== '')

                                                No pupils found.

                                            @else

                                                No pupils registered yet.

                                            @endif

                                        </strong>

                                        <p>

                                            @if ($search !== '')

                                                Try searching with a different name or admission number.

                                            @else

                                                Registered pupils will appear here after registration.

                                            @endif

                                        </p>

                                    </div>

                                </td>

