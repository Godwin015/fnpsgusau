<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Academic Sessions | FNPS Gusau</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 1000px; margin: 35px auto; padding: 0 18px; color: #243047; }
        h1, h2 { color: #173c2b; }
        .panel { border: 1px solid #ddd; border-radius: 8px; padding: 20px; margin: 22px 0; }
        label { display: block; margin-top: 12px; font-weight: bold; }
        input { box-sizing: border-box; width: 100%; padding: 10px; margin-top: 5px; }
        button { padding: 9px 13px; margin-top: 12px; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
        .success { color: #176b35; }
        .error { color: #a21d1d; }
        .current { font-weight: bold; color: #176b35; }
        .session-form { min-width: 190px; }
        .check { width: auto; }
    </style>
</head>
<body>
    <h1>FNPS Gusau</h1>
    <p>
        <a href="{{ route('staff.dashboard') }}">
            &larr; Back to Staff Dashboard
        </a>
    </p>
    <p>Academic Session Management</p>

    @if (session('success'))
        <p class="success">{{ session('success') }}</p>
    @endif

    @if (session('error'))
        <p class="error">{{ session('error') }}</p>
    @endif

    @if ($errors->any())
        <div class="error">
            <strong>Please correct the following:</strong>
            <ul>
                @foreach ($errors->all() as $error)
                    <li>{{ $error }}</li>
                @endforeach
            </ul>
        </div>
    @endif

    <div class="panel">
        <h2>Create Academic Session</h2>

        <form method="POST" action="{{ route('academic-sessions.store') }}">
            @csrf

            <label for="name">Session name</label>
            <input id="name" name="name" placeholder="e.g. 2026/2027"
                   value="{{ old('name') }}" required maxlength="20">

            <label for="start_date">Start date</label>
            <input id="start_date" type="date" name="start_date"
                   value="{{ old('start_date') }}" required>

            <label for="end_date">End date</label>
            <input id="end_date" type="date" name="end_date"
                   value="{{ old('end_date') }}" required>

            <label>
                <input class="check" type="checkbox" name="is_current" value="1"
                       @checked(old('is_current'))>
                Set as the current academic session
            </label>

            <button type="submit">Create Session</button>
        </form>
    </div>

    <div class="panel">
        <h2>Existing Sessions</h2>

        @if ($sessions->isEmpty())
            <p>No academic sessions have been created yet.</p>
        @else
            @foreach ($sessions as $session)
                <div class="panel">
                    <h3>
                        {{ $session->name }}
                        @if ($session->is_current)
                            <span class="current">— CURRENT</span>
                        @endif
                    </h3>

                    <p>
                        {{ $session->start_date->format('d M Y') }}
                        to
                        {{ $session->end_date->format('d M Y') }}
                    </p>

                    <details>
                        <summary>Edit session</summary>

                        <form class="session-form" method="POST"
                              action="{{ route('academic-sessions.update', $session) }}">
                            @csrf
                            @method('PUT')

                            <label>Session name</label>
                            <input name="name" value="{{ $session->name }}"
                                   required maxlength="20">

                            <label>Start date</label>
                            <input type="date" name="start_date"
                                   value="{{ $session->start_date->format('Y-m-d') }}"
                                   required>

                            <label>End date</label>
                            <input type="date" name="end_date"
                                   value="{{ $session->end_date->format('Y-m-d') }}"
                                   required>

                            <label>
                                <input class="check" type="checkbox" name="is_current"
                                       value="1" @checked($session->is_current)>
                                Current session
                            </label>

                            <button type="submit">Save Changes</button>
                        </form>
                    </details>

                    <form method="POST"
                          action="{{ route('academic-sessions.destroy', $session) }}"
                          onsubmit="return confirm('Delete this academic session?');">
                        @csrf
                        @method('DELETE')
                        <button type="submit">Delete Session</button>
                    </form>
                </div>
            @endforeach
        @endif
    </div>
</body>
</html>

